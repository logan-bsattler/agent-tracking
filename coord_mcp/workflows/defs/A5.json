{
  "code": "A5",
  "name": "FDD review assigned to Ben",
  "group": "A",
  "engine": true,
  "trigger": "a client tracker assigns Ben an FDD to review or size",
  "steps": [
    {
      "key": "ingest",
      "name": "Ingest",
      "who": "code",
      "kinds": [],
      "gate": "triage proposes the intent",
      "next": "master tasks a read",
      "sla": {
        "business_hours": 4
      }
    },
    {
      "key": "read",
      "name": "Read FDD and code",
      "who": "agent",
      "kinds": [
        "investigation",
        "data_pull"
      ],
      "gate": "result validates",
      "next": "result names the findings document",
      "sla": {
        "business_days": 10,
        "why": "refit to p75 of 5 observed stays (2026-11-15; Ben 2026-11-15)"
      }
    },
    {
      "key": "findings",
      "name": "Findings and questions",
      "who": "agent",
      "kinds": [
        "deliverable",
        "code_change"
      ],
      "gate": "HTML or the Logan format; never Markdown",
      "next": "document lands",
      "sla": {
        "business_days": 2
      },
      "spawn": {
        "on": "client_follow_up",
        "kind": "deliverable",
        "title": "{client}: findings for {root_title}",
        "spec": {
          "goal": "{follow_up}",
          "read_first": "coord_get_task_result {prev} (the step before this one in case {case}: {root_title}).",
          "constraints": [
            "Write in <client>/work/, never deliverables/.",
            "Format: HTML, or .docx where the FDD format is defined. Never Markdown.",
            "Say Devoir, never offshore."
          ],
          "created_by": "workflow engine ({workflow}, case {case})"
        },
        "spec_defaults": {
          "deliverable_type": "fdd-review",
          "format": "html"
        }
      }
    },
    {
      "key": "review",
      "name": "Review",
      "who": "code",
      "kinds": [
        "dod_review"
      ],
      "gate": "checklist for the deliverable type",
      "next": "approve",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "ben",
      "name": "Promote",
      "who": "code",
      "kinds": [],
      "gate": "auto-promoted when the dod_review approves (auto_promote switch); Promote on /deliverables if refused",
      "next": "promoted",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "reply",
      "name": "Reply or tracker comment",
      "who": "agent",
      "kinds": [
        "draft_reply",
        "deliverable"
      ],
      "gate": "nothing sends or posts",
      "next": "draft lands",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "send",
      "name": "Send or paste",
      "who": "ben",
      "kinds": [],
      "gate": "Ben sends or pastes",
      "next": "case done",
      "sla": {
        "business_days": 10,
        "why": "refit to p75 of 8 observed stays (2026-11-15; Ben 2026-11-15)"
      }
    }
  ]
}
