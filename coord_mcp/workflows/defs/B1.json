{
  "code": "B1",
  "name": "FDD or requirement to production",
  "group": "B",
  "engine": true,
  "trigger": "pipeline item, signed FDD or requirement",
  "steps": [
    {
      "key": "spec_in",
      "name": "Spec in",
      "who": "code",
      "kinds": [],
      "gate": "pipeline item or intent",
      "next": "master tasks sizing",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "sizing",
      "name": "Sizing",
      "who": "agent",
      "kinds": [
        "investigation",
        "deliverable",
        "data_pull"
      ],
      "gate": "sizing checklist",
      "next": "estimate lands",
      "sla": {
        "business_days": 3
      }
    },
    {
      "key": "estimate_ok",
      "name": "Approve estimate",
      "who": "ben",
      "kinds": [],
      "gate": "inside the estimate band (high/low <= estimate_max_ratio, high <= estimate_max_high h; switch auto_estimate) code accepts it; else Ben approves. Status and dates stay his",
      "next": "auto-accept decision or Ben's ruling",
      "auto": {
        "rule": "estimate_band",
        "fallback": "ben"
      },
      "sla": {
        "business_days": 3
      }
    },
    {
      "key": "handoff",
      "name": "Architect handoff",
      "who": "agent",
      "kinds": [
        "code_change",
        "investigation"
      ],
      "gate": "qad-architect-handoff",
      "next": "handoff names the build",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "design_ruling",
      "name": "Ben rules on the design",
      "who": "ben",
      "kinds": [],
      "optional": true,
      "gate": "Ben rules on the handoff's open questions before the build",
      "next": "Ben's ruling",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "build",
      "name": "Build and dev compile",
      "who": "agent",
      "kinds": [
        "code_change"
      ],
      "gate": "build and dev-compile only; do not check in",
      "next": "build lands",
      "sla": {
        "business_days": 5
      },
      "spawn": {
        "on": "client_follow_up",
        "after": "handoff",
        "kind": "code_change",
        "title": "{client}: build for {root_title}",
        "spec": {
          "goal": "{follow_up}",
          "read_first": "coord_get_task_result {prev} (the step before this one in case {case}: {root_title}).",
          "constraints": [
            "Build and dev-compile only; do not check in.",
            "Return compile: \"clean\" only when the build and dev-compile ran with no errors or warnings.",
            "Say Devoir, never offshore."
          ],
          "created_by": "workflow engine ({workflow}, case {case})"
        },
        "cvc": true
      }
    },
    {
      "key": "review",
      "name": "Review",
      "who": "code",
      "kinds": [
        "dod_review"
      ],
      "gate": "cvc-code checklist",
      "next": "approve",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "checkin_ok",
      "name": "Check-in approval",
      "who": "code",
      "fallback": "ben",
      "kinds": [],
      "gate": "checkin_auto: review approves, files unchanged, compile clean, veto window passed; else Ben approves the check-in",
      "next": "master creates the check-in",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "checkin",
      "name": "Check-in",
      "who": "agent",
      "kinds": [
        "code_change"
      ],
      "gate": "gate.check_checkin",
      "next": "checked in",
      "sla": {
        "business_days": 1
      },
      "match": {
        "spec_has": "checkin_of"
      }
    },
    {
      "key": "note",
      "name": "Pipeline note",
      "who": "code",
      "kinds": [],
      "gate": "pipeline-note claim",
      "next": "note added",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "evidence",
      "name": "Test evidence",
      "who": "agent",
      "kinds": [
        "deliverable",
        "investigation"
      ],
      "gate": "test-evidence checklist",
      "next": "evidence lands",
      "sla": {
        "business_days": 3
      }
    },
    {
      "key": "promote",
      "name": "Promote DEVL/TEST/PROD",
      "who": "ben",
      "kinds": [],
      "gate": "promotion asks are Ben's (A4)",
      "next": "installed",
      "sla": {
        "business_days": 3
      }
    },
    {
      "key": "signoff",
      "name": "UAT sign-off",
      "who": "ben",
      "kinds": [],
      "gate": "client signs off; Ben records it",
      "next": "case done",
      "sla": {
        "business_days": 10
      }
    }
  ]
}
