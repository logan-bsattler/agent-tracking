{
  "code": "A3",
  "name": "Defect or change report",
  "group": "A",
  "engine": true,
  "trigger": "a client reports delivered work wrong or missing",
  "steps": [
    {
      "key": "ingest",
      "name": "Ingest",
      "who": "code",
      "kinds": [],
      "gate": "triage proposes the intent",
      "next": "master tasks an investigation",
      "sla": {
        "business_hours": 4
      }
    },
    {
      "key": "investigate",
      "name": "Investigate",
      "who": "agent",
      "kinds": [
        "investigation",
        "data_pull",
        "review"
      ],
      "gate": "result validates",
      "next": "result names a fix for the client agent",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "fix",
      "name": "Fix",
      "who": "agent",
      "kinds": [
        "code_change"
      ],
      "gate": "build and dev-compile only",
      "next": "fix lands",
      "sla": {
        "business_days": 3
      },
      "spawn": {
        "on": "client_follow_up",
        "kind": "code_change",
        "title": "{client}: fix for {root_title}",
        "spec": {
          "goal": "{follow_up}",
          "read_first": "coord_get_task_result {prev} (the step before this one in case {case}: {root_title}).",
          "constraints": [
            "Build and dev-compile only; do not check in.",
            "Say Devoir, never offshore."
          ],
          "created_by": "workflow engine ({workflow}, case {case})"
        },
        "cvc": true
      }
    },
    {
      "key": "review",
      "name": "Review",
      "who": "code",
      "kinds": [
        "dod_review"
      ],
      "gate": "cvc-code checklist",
      "next": "approve",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "checkin_ok",
      "name": "Check-in approval",
      "who": "ben",
      "kinds": [],
      "gate": "Ben approves the check-in",
      "next": "master creates the check-in",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "checkin",
      "name": "Check-in",
      "who": "agent",
      "kinds": [
        "code_change"
      ],
      "gate": "gate.check_checkin: code approved and unchanged",
      "next": "checked in",
      "sla": {
        "business_days": 1
      },
      "match": {
        "spec_has": "checkin_of"
      }
    },
    {
      "key": "note",
      "name": "Pipeline note",
      "who": "code",
      "kinds": [],
      "gate": "pipeline-note claim",
      "next": "note added",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "reply",
      "name": "Reply",
      "who": "agent",
      "kinds": [
        "draft_reply"
      ],
      "gate": "nothing sends",
      "next": "draft lands",
      "sla": {
        "business_days": 1
      },
      "spawn": {
        "on": "result",
        "after": "checkin",
        "kind": "draft_reply",
        "title": "{client}: reply on {root_title}",
        "spec": {
          "goal": "Draft the reply to the client email this case answers ({root_title}), from the finished step's result.",
          "read_first": "coord_get_task_result {prev} with fields [\"verdict\", \"evidence\", \"pointers\", \"summary\"]; the case's intent is {intent}.",
          "reply_from": "{reply_from}",
          "reply_date": "{reply_date}",
          "constraints": [
            "Nothing sends: write the body to a file and return the draft_reply envelope.",
            "The body ends with 'Thanks!' and no name; Ben's Outlook signature carries it.",
            "Promise nothing no task covers; if the answer needs more work, put it in follow_ups instead.",
            "Say Devoir, never offshore."
          ],
          "created_by": "workflow engine ({workflow}, case {case})"
        },
        "takes_follow_up": "repl|draft|email|answer|respond|tell|confirm"
      }
    },
    {
      "key": "send",
      "name": "Send",
      "who": "ben",
      "kinds": [],
      "gate": "Ben sends",
      "next": "case done",
      "sla": {
        "business_days": 1
      }
    }
  ]
}
