{
  "code": "B3",
  "name": "Environment refresh recovery",
  "group": "B",
  "engine": true,
  "trigger": "DEVL refreshed (or about to be) from PROD",
  "steps": [
    {
      "key": "notice",
      "name": "Notice",
      "who": "code",
      "kinds": [],
      "gate": "triage",
      "next": "master tasks the in-flight list",
      "sla": {
        "business_hours": 4
      }
    },
    {
      "key": "inflight",
      "name": "List in-flight work",
      "who": "agent",
      "kinds": [
        "investigation",
        "data_pull"
      ],
      "gate": "result lists what the refresh wipes",
      "next": "list lands",
      "sla": {
        "business_days": 1
      }
    },
    {
      "key": "confirm",
      "name": "Confirm to QAD",
      "who": "ben",
      "kinds": [],
      "gate": "Ben confirms the timing with QAD",
      "next": "Ben's ruling",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "restore",
      "name": "Restore setup",
      "who": "agent",
      "kinds": [
        "code_change"
      ],
      "gate": "build and dev-compile only",
      "next": "setup restored",
      "sla": {
        "business_days": 2
      }
    },
    {
      "key": "reverify",
      "name": "Re-verify",
      "who": "agent",
      "kinds": [
        "investigation"
      ],
      "gate": "checked against data",
      "next": "case done",
      "sla": {
        "business_days": 1
      },
      "spawn": {
        "on": "result",
        "after": "restore",
        "kind": "investigation",
        "title": "{client}: re-verify after refresh, {root_title}",
        "spec": {
          "question": "After the restore in task {prev}, does each item it restored work again in DEVL? One line per item.",
          "read_first": "coord_get_task_result {prev}",
          "constraints": [
            "Read only."
          ],
          "created_by": "workflow engine ({workflow}, case {case})"
        }
      }
    }
  ]
}
